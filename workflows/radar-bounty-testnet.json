      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Bandingkan isi halaman dengan kunjungan sebelumnya.\n// Hash disimpan di workflow static data, jadi tetap ada walau n8n restart.\nconst crypto = require('crypto');\nconst item = $input.first().json;\nconst content = item.data || '';\nconst hash = crypto.createHash('sha256').update(content).digest('hex');\nconst staticData = $getWorkflowStaticData('global');\nconst url = item.url;\nconst prev = staticData[url];\nconst firstRun = prev === undefined;\nstaticData[url] = hash;\nreturn [{\n  json: {\n    url,\n    hash,\n    changed: !firstRun && prev !== hash,\n    firstRun,\n    length: content.length,\n  },\n}];"
      },
      "id": "c3af3a15-079a-40f2-a17e-833fd91b87ea",
      "name": "Hitung Hash & Bandingkan",
